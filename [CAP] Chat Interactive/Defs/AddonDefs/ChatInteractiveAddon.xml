    <buttonType>Divider</buttonType>
    <sourceMod>RICS</sourceMod>
    <enabled>true</enabled>
    <displayOrder>86</displayOrder>
    <showInToolbar>true</showInToolbar>
    <!-- no label, icon, dialogClass, etc. needed -->
