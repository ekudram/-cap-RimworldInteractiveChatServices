<!--
  =============================================================================
  RICS Addon Menu — third-party mod cookbook
  =============================================================================

  PURPOSE
    Let other mods add buttons to the RICS main tab (bottom "RICS" MainButton)
    and optionally the top quick toolbar while playing.

  HOW TO ADD BUTTONS (recommended)
    Ship an XML Def of type CAP_ChatInteractive.EnhancedChatInteractiveAddonDef
    in your own mod's Defs/ folder (any filename). No C# required for simple
    DirectDialogButton entries — only a Verse.Window with a parameterless ctor.

  C# RUNTIME API (toolbar only)
    CAP_ChatInteractive.ButtonUtils
      AddDirectDialogButton / AddToggleWindowButton / AddMenuButton / AddModSettingsButton
      RemoveButton / RemoveAllButtonsFromMod / IsRICSLoaded
    Runtime buttons appear on the top toolbar only, not in DefDatabase/main tab.
    Prefer XML if you need the main tab list and load-order safety.

  LOAD ORDER
    Load after RICS ([CAP] Rimworld Interactive Chat Service / packageId Captolamia.RICS).

  BUTTON TYPES (buttonType field)
    MenuButton         — menuClass implementing CAP_ChatInteractive.Interfaces.IAddonMenu
                         (returns List<FloatMenuOption>)
    DirectDialogButton — dialogClass : Verse.Window (opens immediately)
    ToggleWindowButton — windowClass : Verse.Window (open if closed, close if open)
    SubmenuButton      — same as MenuButton (legacy alias)
    Divider            — visual separator only; unique defName required; no label/icon/action

  COMMON FIELDS
    defName       — unique across the game (prefix with your mod id)
    label         — button text (main tab) / tooltip base
    description   — used as tooltip if tooltip empty
    enabled       — false hides the button
    displayOrder  — sort key. RICS uses ~85–101; third-party should use 200+ (or 1000+)
    sourceMod     — short name for grouping (toolbar separators / main-tab headers)
    showInToolbar — true shows icon on top quick toolbar during play
    iconPath      — Textures path, e.g. UI/QuickButtons/MyIcon (optional)
    tooltip       — optional hover text
    hotkey        — optional KeyBindingDef (toolbar)
    category      — optional organizational tag

  TYPE-SPECIFIC FIELDS
    MenuButton:         menuClass
    DirectDialogButton: dialogClass
    ToggleWindowButton: windowClass
    Divider:            none of the above

  EXAMPLE — third-party DirectDialogButton (copy into your mod's Defs/)

    <CAP_ChatInteractive.EnhancedChatInteractiveAddonDef>
      <defName>MyMod_OpenSettings</defName>
      <label>My Mod Settings</label>
      <description>Open My Mod settings</description>
      <dialogClass>MyNamespace.Dialog_MySettings</dialogClass>
      <buttonType>DirectDialogButton</buttonType>
      <sourceMod>My Mod</sourceMod>
      <enabled>true</enabled>
      <displayOrder>500</displayOrder>
      <showInToolbar>true</showInToolbar>
      <iconPath>UI/MyMod/Icon</iconPath>
    </CAP_ChatInteractive.EnhancedChatInteractiveAddonDef>

  EXAMPLE — MenuButton with custom C# class implementing IAddonMenu

    <CAP_ChatInteractive.EnhancedChatInteractiveAddonDef>
      <defName>MyMod_ToolsMenu</defName>
      <label>My Tools</label>
      <menuClass>MyNamespace.MyAddonMenu</menuClass>
      <buttonType>MenuButton</buttonType>
      <sourceMod>My Mod</sourceMod>
      <enabled>true</enabled>
      <displayOrder>510</displayOrder>
      <showInToolbar>false</showInToolbar>
    </CAP_ChatInteractive.EnhancedChatInteractiveAddonDef>

  DIVIDERS
    Each divider needs a unique defName. They only draw a separator at displayOrder.

  ERRORS
    Bad types are reported via Def ConfigErrors and logged as [AddonMenu] when clicked.
  =============================================================================
-->

<Defs>
  <!-- Main Interactive Service Button (Existing) -->
  <CAP_ChatInteractive.EnhancedChatInteractiveAddonDef>
    <defName>CAPChatInteractive</defName>
    <label>Rimworld Interactive Chat Service</label>
    <description>Main menu for CAP Chat Interactive mod features</description>
    <menuClass>CAP_ChatInteractive.ChatInteractiveAddonMenu</menuClass>
    <buttonType>MenuButton</buttonType>
    <sourceMod>RICS</sourceMod>
    <enabled>true</enabled>
    <displayOrder>85</displayOrder>
    <showInToolbar>true</showInToolbar>
    <iconPath>UI/QuickButtons/CommandEditor</iconPath>
  </CAP_ChatInteractive.EnhancedChatInteractiveAddonDef>

  <!-- Divider (note each Divider must have a custom defName)-->
  <CAP_ChatInteractive.EnhancedChatInteractiveAddonDef>
