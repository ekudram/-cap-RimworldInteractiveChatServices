  <!-- ============================================== -->
  <!--  Move Royalty psychic apparel from ApparelMisc to ApparelClothing -->
  <!-- ============================================== -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_PsyfocusShirt"]/thingCategories</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Apparel_PsyfocusShirt"]/thingCategories</xpath>
      <value>
        <thingCategories>
          <li>ApparelClothing</li>
        </thingCategories>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_PsyfocusVest"]/thingCategories</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Apparel_PsyfocusVest"]/thingCategories</xpath>
      <value>
        <thingCategories>
          <li>ApparelClothing</li>
        </thingCategories>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_PsyfocusRobe"]/thingCategories</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Apparel_PsyfocusRobe"]/thingCategories</xpath>
      <value>
        <thingCategories>
          <li>ApparelClothing</li>
        </thingCategories>
      </value>
    </match>
  </Operation>

</Patch>
