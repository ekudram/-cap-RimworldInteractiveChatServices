<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ============================================== -->
  <!--  Add new subcategory for clothing under Apparel -->
  <!-- ============================================== -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
      <ThingCategoryDef>
        <defName>ApparelClothing</defName>
        <label>clothing</label>
        <parent>Apparel</parent>
      </ThingCategoryDef>
    </value>
  </Operation>

  <!-- ============================================== -->
  <!--  Move apparel that was in ApparelMisc to ApparelClothing -->
  <!-- ============================================== -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_TribalA"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>ApparelClothing</li>
      </thingCategories>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_Parka"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>ApparelClothing</li>
      </thingCategories>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_Pants"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>ApparelClothing</li>
      </thingCategories>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_BasicShirt"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>ApparelClothing</li>
      </thingCategories>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_CollarShirt"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>ApparelClothing</li>
      </thingCategories>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_Duster"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>ApparelClothing</li>
      </thingCategories>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_Jacket"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>ApparelClothing</li>
      </thingCategories>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Apparel_Robe"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>ApparelClothing</li>
      </thingCategories>
    </value>
  </Operation>

  <!-- Lab coat is Anomaly content. MayRequire on a patch operation is ignored, so test for the def. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_LabCoat"]/thingCategories</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Apparel_LabCoat"]/thingCategories</xpath>
      <value>
        <thingCategories>
          <li>ApparelClothing</li>
        </thingCategories>
      </value>
    </match>
  </Operation>

  <!-- ============================================== -->
  <!--  Move Biotech apparel from ApparelMisc to ApparelUtility -->
  <!-- ============================================== -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_Bandolier"]/thingCategories</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Apparel_Bandolier"]/thingCategories</xpath>
      <value>
        <thingCategories>
          <li>ApparelUtility</li>
        </thingCategories>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_Sash"]/thingCategories</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Apparel_Sash"]/thingCategories</xpath>
      <value>
        <thingCategories>
          <li>ApparelUtility</li>
        </thingCategories>
      </value>
    </match>
  </Operation>

  <!-- ============================================== -->
  <!--  Move Ideology apparel from ApparelMisc to proper categories -->
  <!-- ============================================== -->

  <!-- Slave body strap → ApparelUtility -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_BodyStrap"]/thingCategories</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Apparel_BodyStrap"]/thingCategories</xpath>
      <value>
        <thingCategories>
          <li>ApparelUtility</li>
        </thingCategories>
      </value>
    </match>
  </Operation>

  <!-- Burka → ApparelClothing -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_Burka"]/thingCategories</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Apparel_Burka"]/thingCategories</xpath>
      <value>
        <thingCategories>
          <li>ApparelClothing</li>
        </thingCategories>
      </value>
    </match>
