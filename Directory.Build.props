<Project>
  <!-- Windows Details tab. File version must be four numbers. Product version matches chat (modVersion 1.57). -->
  <PropertyGroup>
    <Version>1.57.0</Version>
    <AssemblyVersion>1.57.0.0</AssemblyVersion>
    <FileVersion>1.57.0.0</FileVersion>
    <InformationalVersion>1.57</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
